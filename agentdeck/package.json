{
  "name": "agentdeck",
  "version": "1.29.0",
  "description": "AgentDeck - a standalone Android chat client. Bring your own model provider API key.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/NETO-DEV66/Opanhand-mobile-"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@react-router/node": "7.18.2",
    "@tailwindcss/vite": "4.3.3",
    "isbot": "^5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.2",
    "sirv": "3.0.2",
    "tailwindcss": "4.3.3"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run build:app",
    "build:app": "react-router build",
    "start": "sirv build --single",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "lint": "npm run typecheck && eslint src && prettier --check src/**/*.{ts,tsx}",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@eslint/js": "9.39.4",
    "@react-router/dev": "7.18.2",
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "16.5.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "packageManager": "npm@10.5.0",
  "volta": {
    "node": "24.21.0"
  }
