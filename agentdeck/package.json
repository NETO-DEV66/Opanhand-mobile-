{
  "name": "agentdeck",
  "version": "1.29.0",
  "description": "AgentDeck - a standalone Android chat client. Bring your own model provider API key.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/NETO-DEV66/Opanhand-mobile-"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "isbot": "^5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "sirv": "3.0.2",
    "tailwindcss": "4.3.3"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run build:app",
    "build:app": "react-router build",
    "start": "sirv build --single",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "test": "vite-node e2e-chat.test.ts",
    "lint": "npm run typecheck && eslint src e2e-chat.test.ts && prettier --check src/**/*.{ts,tsx} e2e-chat.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.4.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "npm@10.5.0",
  "volta": {
    "node": "24.21.0"
  }
}
